# Copy this file to .env and adjust the values. Never commit .env.

# Docker Hub account that owns the image (required)
DOCKERHUB_USERNAME=your-dockerhub-username
# Image tag used when building and pushing the api image
IMAGE_TAG=1.0.0

# Build arguments recorded in the image (labels + environment)
MODEL_VERSION=1.0.0
GIT_SHA=unknown

# Host port that publishes the api (container port is always 8000)
API_HOST_PORT=8090

# Service configuration
DECISION_THRESHOLD=0.5
LOG_LEVEL=INFO

# REDIS_HOST and REDIS_PORT are set in docker-compose.yml to the
# redis service name and its port (6379); the api counts requests
# only when REDIS_HOST is set.
